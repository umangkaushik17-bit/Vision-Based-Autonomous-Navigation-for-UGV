# =============================================================================
# SIH26126 — Vision-Based Autonomous UGV Navigation (.gitignore)
# Configured so a fresh git clone includes all required models, C++ binaries,
# SDF worlds, 3D meshes, and test fixtures to run out-of-the-box.
# =============================================================================

# Python bytecode & build caches
__pycache__/
*.py[cod]
*$py.class
*.o
*.exp
*.lib
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Keep compiled C++17 A* and DWA shared libraries for zero-setup execution
*.so
!ai/planning/native_cpp/*.so
!ai/planning/native_cpp/*.dll

# Keep 3D Gazebo mesh assets (.obj) while ignoring C++ intermediate object files
*.obj
!simulation/models/**/*.obj

# Virtual Environments
venv/
.venv/
.venv*/
env/
.env
.env.*
!.env.example

# Large Raw Datasets & Intermediate Training Checkpoints
/data/processed/
/data/benchmark_test/
/datasets/
/models/
/artifacts/
/references/
/rellis3d_gpu_ready/checkpoints/
/tools/kaggle/dataset/
/tools/kaggle/eval_dataset/
*.bag
*.tar
*.tar.gz
gpu_data.zip
gpu_code.zip
gpu_results.zip

# Outputs: Ignore bulky training logs/epochs, but KEEP production ONNX, best.pt, and planning/reports artifacts
/output/
/outputs/*
!/outputs/exports/
!/outputs/planning/
!/outputs/reports/
!/outputs/rellis3d/
/outputs/rellis3d/*
!/outputs/rellis3d/checkpoints/
/outputs/rellis3d/checkpoints/epoch_*.pt
/outputs/rellis3d/checkpoints/latest.pt

# Simulation Outputs: Keep required telemetry fixtures, ignore bulky Kaggle dumps
simulation/outputs/*
!simulation/outputs/phase16/
!simulation/outputs/dynamic_visualization/

# ROS 2 Colcon build directories (source packages in ros2_ws/src/ are tracked)
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Testing, IDE & OS caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.vscode/
.idea/
*.swp
*.swo
*.log
*.tmp
*.bak
Thumbs.db
.DS_Store
