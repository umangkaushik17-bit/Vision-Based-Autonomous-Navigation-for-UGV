<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="outdoor_presentation_100m">

    <!-- Physics Engine Configuration (Lightweight ODE for 200 Hz update) -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <!-- Essential Gazebo Sim System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Visual Scene & Outdoor Atmosphere -->
    <scene>
      <ambient>0.62 0.64 0.68 1.0</ambient>
      <background>0.55 0.72 0.90 1.0</background>
      <sky>
        <clouds>
          <speed>10</speed>
        </clouds>
      </sky>
      <shadows>true</shadows>
    </scene>

    <!-- Sun & Outdoor Directional Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>50.0 0.0 40.0 0 0.75 0.45</pose>
      <diffuse>0.92 0.88 0.82 1.0</diffuse>
      <specular>0.05 0.05 0.05 1.0</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.45 0.25 -0.85</direction>
    </light>

    <!-- ================================================================= -->
    <!-- BASE MEADOW TERRAIN PLANE (160m x 80m, z = 0.0, mu = 1.0)        -->
    <!-- Serves as the sole authoritative physical collision plane        -->
    <!-- ================================================================= -->
    <model name="ground_plane">
      <static>true</static>
      <pose>50.0 -5.0 0.0 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>160 80</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>160 80</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.30 0.38 0.22 1.0</ambient>
            <diffuse>0.35 0.45 0.26 1.0</diffuse>
            <specular>0.05 0.05 0.05 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

