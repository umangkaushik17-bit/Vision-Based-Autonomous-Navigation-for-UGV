<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="outdoor_terrain">

    <physics name="default_physics" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <!-- Sun & Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0.8 0.5</pose>
      <diffuse>0.9 0.85 0.8 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.2 -0.85</direction>
    </light>

    <!-- Ground Plane (Grass / Dirt Terrain) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.9</mu>
                <mu2>0.9</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.40 0.25 1.0</ambient>
            <diffuse>0.40 0.48 0.30 1.0</diffuse>
            <specular>0.05 0.05 0.05 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 1: Large Granite Boulder -->
    <model name="rock_boulder_large">
      <static>true</static>
      <pose>3.5 0.5 0.3 0 0 0.35</pose>
      <link name="rock_link">
        <collision name="rock_collision">
          <geometry>
            <box>
              <size>1.2 1.2 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="rock_visual">
          <geometry>
            <box>
              <size>1.2 1.2 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.42 0.40 1.0</ambient>
            <diffuse>0.50 0.48 0.45 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: Pine Tree Trunk -->
    <model name="tree_pine_trunk">
      <static>true</static>
      <pose>5.0 -1.5 1.5 0 0 0</pose>
      <link name="tree_link">
        <collision name="tree_collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="tree_visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>3.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.35 0.22 0.12 1.0</ambient>
            <diffuse>0.40 0.26 0.15 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Hazard 1: Muddy Water Pool (Reflective Low-Traction Patch) -->
    <model name="water_hazard_patch">
      <static>true</static>
      <pose>4.0 -0.8 0.005 0 0 0</pose>
      <link name="water_link">
        <collision name="water_collision">
          <geometry>
            <cylinder>
              <radius>0.75</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.15</mu> <!-- Low traction hazard -->
                <mu2>0.15</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="water_visual">
          <geometry>
            <cylinder>
              <radius>0.75</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.25 0.35 0.8</ambient>
            <diffuse>0.20 0.35 0.50 0.8</diffuse>
            <specular>0.9 0.9 0.9 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Hazard 2: Erosion Ditch (Depression / Negative Obstacle) -->
    <model name="ditch_hazard_trench">
      <static>true</static>
      <pose>7.0 1.0 -0.2 0 0 0</pose>
      <link name="ditch_link">
        <collision name="ditch_collision">
          <geometry>
            <box>
              <size>1.2 2.5 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="ditch_visual">
          <geometry>
            <box>
              <size>1.2 2.5 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.18 0.12 1.0</ambient>
            <diffuse>0.28 0.20 0.14 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Terrain Feature: Gravel Slope Ramp -->
    <model name="gravel_slope_ramp">
      <static>true</static>
      <pose>10.0 0.0 0.4 0 0.20944 0</pose> <!-- pitch = 12 deg -->
      <link name="ramp_link">
        <collision name="ramp_collision">
          <geometry>
            <box>
              <size>4.0 3.0 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="ramp_visual">
          <geometry>
            <box>
              <size>4.0 3.0 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.48 0.45 0.40 1.0</ambient>
            <diffuse>0.52 0.50 0.44 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
