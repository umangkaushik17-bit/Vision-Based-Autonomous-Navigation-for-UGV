      <pose>32.00 7.50 0.35 0 0 -1.570796</pose>
      <link name="dynamic_obs_w2_link">
        <inertial><mass>25.0</mass><inertia><ixx>0.5</ixx><ixy>0.0</ixy><ixz>0.0</ixz><iyy>0.5</iyy><iyz>0.0</iyz><izz>0.7</izz></inertia></inertial>
        <collision name="obstacle_collision">
          <geometry><box><size>0.8 0.8 0.6</size></box></geometry>
