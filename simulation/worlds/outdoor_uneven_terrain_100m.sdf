<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="outdoor_uneven_terrain_100m">

    <!-- Physics Engine Configuration (200 Hz ODE for 2.5D terrain contact stability) -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <!-- Essential Gazebo Sim System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Visual Scene & Outdoor Atmosphere -->
    <scene>
      <ambient>0.62 0.64 0.68 1.0</ambient>
      <background>0.55 0.72 0.90 1.0</background>
      <sky>
        <clouds>
          <speed>10</speed>
        </clouds>
      </sky>
      <shadows>true</shadows>
    </scene>

    <!-- Sun & Outdoor Directional Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>50.0 0.0 40.0 0 0.75 0.45</pose>
      <diffuse>0.92 0.88 0.82 1.0</diffuse>
      <specular>0.05 0.05 0.05 1.0</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.45 0.25 -0.85</direction>
    </light>

    <!-- ================================================================= -->
    <!-- BASE MEADOW TERRAIN PLANE (160m x 80m, z = 0.0, mu = 1.0)        -->
    <!-- ================================================================= -->
    <model name="ground_plane">
      <static>true</static>
      <pose>50.0 -5.0 0.0 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>160 80</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>160 80</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.30 0.38 0.22 1.0</ambient>
            <diffuse>0.35 0.45 0.26 1.0</diffuse>
            <specular>0.05 0.05 0.05 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- CANONICAL WAYPOINT JUNCTION MARKERS (START, W1, W2, W3, W4, W5)   -->
    <!-- ================================================================= -->
    <model name="trail_junction_start">
      <static>true</static>
      <pose>0.00 0.00 0.0025 0 0 0</pose>
      <link name="junction_link">
        <visual name="junction_visual">
          <geometry><cylinder><radius>1.45</radius><length>0.0020</length></cylinder></geometry>
          <material><ambient>0.32 0.42 0.28 1.0</ambient><diffuse>0.38 0.48 0.32 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="trail_junction_w1">
      <static>true</static>
      <pose>20.00 0.00 0.0025 0 0 0</pose>
      <link name="junction_link">
        <visual name="junction_visual">
          <geometry><cylinder><radius>1.45</radius><length>0.0020</length></cylinder></geometry>
          <material><ambient>0.32 0.42 0.28 1.0</ambient><diffuse>0.38 0.48 0.32 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="trail_junction_w2">
      <static>true</static>
      <pose>40.00 6.00 0.0025 0 0 0</pose>
      <link name="junction_link">
        <visual name="junction_visual">
          <geometry><cylinder><radius>1.45</radius><length>0.0020</length></cylinder></geometry>
          <material><ambient>0.32 0.42 0.28 1.0</ambient><diffuse>0.38 0.48 0.32 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="trail_junction_w3">
      <static>true</static>
      <pose>60.00 -4.00 0.0025 0 0 0</pose>
      <link name="junction_link">
        <visual name="junction_visual">
          <geometry><cylinder><radius>1.45</radius><length>0.0020</length></cylinder></geometry>
          <material><ambient>0.32 0.42 0.28 1.0</ambient><diffuse>0.38 0.48 0.32 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="trail_junction_w4">
      <static>true</static>
      <pose>80.00 3.00 0.0025 0 0 0</pose>
      <link name="junction_link">
        <visual name="junction_visual">
          <geometry><cylinder><radius>1.45</radius><length>0.0020</length></cylinder></geometry>
          <material><ambient>0.32 0.42 0.28 1.0</ambient><diffuse>0.38 0.48 0.32 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="trail_junction_w5">
      <static>true</static>
      <pose>100.00 0.00 0.0025 0 0 0</pose>
      <link name="junction_link">
        <visual name="junction_visual">
          <geometry><cylinder><radius>1.45</radius><length>0.0020</length></cylinder></geometry>
          <material><ambient>0.32 0.42 0.28 1.0</ambient><diffuse>0.38 0.48 0.32 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- PHASE 15 2.5D UNEVEN TERRAIN FEATURES (SUBPHASE 15.8)             -->
    <!-- ================================================================= -->

    <!-- Feature 1: 32 deg Steep Grassy Embankment (Lethal Rollover Hazard > 28 deg) -->
    <model name="steep_embankment_32deg">
      <static>true</static>
      <!-- pitch = -0.5585 rad (32.0 deg incline blocking direct W1->W2 centerline) -->
      <pose>30.00 2.00 0.65 0 -0.5585 0.28</pose>
      <link name="embankment_link">
        <collision name="embankment_collision">
          <geometry><box><size>5.0 3.2 0.30</size></box></geometry>
        </collision>
        <visual name="embankment_visual">
          <geometry><box><size>5.0 3.2 0.30</size></box></geometry>
          <material>
            <!-- Visually green grass (deceptive to 2D semantic-only stacks!) -->
            <ambient>0.28 0.44 0.22 1.0</ambient>
            <diffuse>0.34 0.52 0.26 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Feature 2: 10 deg Gentle Dirt Bypass Ramp (Safe Switchback Corridor) -->
    <model name="gentle_bypass_ramp_10deg">
      <static>true</static>
      <!-- pitch = -0.1745 rad (10.0 deg gentle dirt ramp alongside the embankment) -->
      <pose>30.00 6.20 0.35 0 -0.1745 0.15</pose>
      <link name="bypass_ramp_link">
        <collision name="bypass_ramp_collision">
          <geometry><box><size>8.0 3.0 0.20</size></box></geometry>
        </collision>
        <visual name="bypass_ramp_visual">
          <geometry><box><size>8.0 3.0 0.20</size></box></geometry>
          <material>
            <ambient>0.46 0.36 0.24 1.0</ambient>
            <diffuse>0.54 0.42 0.28 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Feature 3: 24 deg Severe Lateral Cross-Slope Bank (W2 -> W3 sector) -->
    <model name="severe_cross_slope_24deg">
      <static>true</static>
      <!-- roll = 0.4189 rad (24.0 deg lateral cross-slope) -->
      <pose>50.00 2.50 0.45 0.4189 0 -0.45</pose>
      <link name="cross_slope_link">
        <collision name="cross_slope_collision">
          <geometry><box><size>7.5 3.0 0.25</size></box></geometry>
        </collision>
        <visual name="cross_slope_visual">
          <geometry><box><size>7.5 3.0 0.25</size></box></geometry>
          <material>
            <ambient>0.40 0.38 0.26 1.0</ambient>
            <diffuse>0.48 0.45 0.30 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Feature 4: 20 cm Vertical Step Boulder Cluster (High-Centering Hazard >= 0.12m) -->
    <model name="step_boulder_cluster_20cm">
      <static>true</static>
      <pose>66.00 -1.50 0.10 0 0 0</pose>
      <link name="step_boulder_1">
        <pose>0.0 0.0 0.0 0 0 0</pose>
        <collision name="col_1"><geometry><box><size>1.8 1.8 0.20</size></box></geometry></collision>
        <visual name="vis_1">
          <geometry><box><size>1.8 1.8 0.20</size></box></geometry>
          <material><ambient>0.42 0.40 0.38 1.0</ambient><diffuse>0.50 0.48 0.45 1.0</diffuse></material>
        </visual>
      </link>
      <link name="step_boulder_2">
        <pose>1.6 0.9 -0.01 0 0 0.35</pose>
        <collision name="col_2"><geometry><box><size>1.4 1.4 0.18</size></box></geometry></collision>
        <visual name="vis_2">
          <geometry><box><size>1.4 1.4 0.18</size></box></geometry>
          <material><ambient>0.40 0.39 0.37 1.0</ambient><diffuse>0.48 0.46 0.44 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Feature 5: -15 cm Negative Ditch / Trench Hazard -->
    <model name="negative_ditch_trench_15cm">
      <static>true</static>
      <pose>73.50 1.20 -0.075 0 0 0.20</pose>
      <link name="ditch_rim_link">
        <collision name="ditch_col"><geometry><box><size>1.2 3.2 0.15</size></box></geometry></collision>
        <visual name="ditch_vis">
          <geometry><box><size>1.2 3.2 0.15</size></box></geometry>
          <material><ambient>0.18 0.15 0.12 1.0</ambient><diffuse>0.22 0.18 0.15 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Feature 6: 12 deg Undulating Pitching Hills (W4 -> W5 sector) -->
    <model name="undulating_pitch_hills_12deg">
      <static>true</static>
      <pose>88.00 1.20 0.0 0 0 -0.15</pose>
      <link name="hill_up_12deg">
        <!-- pitch = -0.2094 rad (+12.0 deg upslope) -->
        <pose>-2.2 0.0 0.24 0 -0.2094 0</pose>
        <collision name="up_col"><geometry><box><size>4.5 4.0 0.15</size></box></geometry></collision>
        <visual name="up_vis">
          <geometry><box><size>4.5 4.0 0.15</size></box></geometry>
          <material><ambient>0.36 0.42 0.25 1.0</ambient><diffuse>0.42 0.48 0.30 1.0</diffuse></material>
        </visual>
      </link>
      <link name="hill_down_12deg">
        <!-- pitch = +0.2094 rad (-12.0 deg downslope) -->
        <pose>2.2 0.0 0.24 0 0.2094 0</pose>
        <collision name="down_col"><geometry><box><size>4.5 4.0 0.15</size></box></geometry></collision>
        <visual name="down_vis">
          <geometry><box><size>4.5 4.0 0.15</size></box></geometry>
          <material><ambient>0.36 0.42 0.25 1.0</ambient><diffuse>0.42 0.48 0.30 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!-- DYNAMIC OBSTACLES (W1 THROUGH W5)                                 -->
    <!-- ================================================================= -->
    <model name="dynamic_obs_w1">
      <static>false</static>
      <pose>16.00 3.20 0.35 0 0 -1.570796</pose>
      <link name="dynamic_obs_w1_link">
        <inertial><mass>25.0</mass><inertia><ixx>0.5</ixx><ixy>0.0</ixy><ixz>0.0</ixz><iyy>0.5</iyy><iyz>0.0</iyz><izz>0.7</izz></inertia></inertial>
        <collision name="obstacle_collision">
          <geometry><box><size>0.8 0.8 0.6</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name="rover_body">
          <geometry><box><size>0.75 0.70 0.45</size></box></geometry>
          <material><ambient>0.85 0.15 0.15 1.0</ambient><diffuse>0.85 0.15 0.15 1.0</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>dynamic_obs_w1_link</link_name>
        <topic>/model/dynamic_obs_w1/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>dynamic_obs_w1_link</robot_base_frame>
        <odom_topic>/model/dynamic_obs_w1/odometry</odom_topic>
        <dimensions>3</dimensions>
      </plugin>
    </model>

